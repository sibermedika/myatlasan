# Node 24+. Development: npm run dev:local (frontend3030, API3031).
HOST=127.0.0.1
PORT=3030
APP_PORT=3030
# Blank means data/ in the project. Keep this directory persistent.
DATA_DIR=
# Only used when creating the FIRST database. Leave blank to generate random credentials.
ADMIN_PASSWORD=
LECTURER_PASSWORD=
# Enable only when serving through HTTPS. Local HTTP must keep false.
COOKIE_SECURE=false
# Reverse proxy: set only the trusted proxy addresses (e.g. loopback), when using HTTPS.
TRUST_PROXY=
