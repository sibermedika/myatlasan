# ==============================================================================
# AnatoVerse - Environment Variables Configuration
# ==============================================================================

# Server Port (Default: 3000 untuk Cloud, 3030 untuk Localhost)
PORT=3000

# Server Host Interface (Default: 0.0.0.0 agar bisa diakses dari network/container)
HOST=0.0.0.0

# Port pemetaan untuk Docker Compose (Default: 3030)
APP_PORT=3030

# Node Environment
NODE_ENV=production

# GEMINI_API_KEY: Opsional untuk AI Studio / Gemini API fitur lanjutan
GEMINI_API_KEY=""

# APP_URL: URL publik tempat aplikasi di-hosting (Cloud Run / VPS / Custom Domain)
APP_URL=""
